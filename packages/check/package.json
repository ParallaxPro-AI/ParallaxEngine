{
  "name": "@parallax/check",
  "private": true,
  "version": "0.0.0",
  "description": "`parallax check`: validates a Parallax project (schemas, references, UI bindings, feature boundaries, budgets) and generates its `project` handles.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@parallax/runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
