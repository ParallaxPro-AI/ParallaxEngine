"""Pure value types. No engine dependency: importable from plain rules modules and plain
`test_*` functions as well as game code.

    from parallax.values import Vec2, Vec3, Color, Cell, Cell3
"""

from parallax import Color as Color, Vec2 as Vec2, Vec3 as Vec3

class Cell:
    """Immutable integer cell (col, row). Hashable, usable as dict keys.
    JSON form: [col, row]."""
    col: int
    row: int
    def __init__(self, col: int, row: int) -> None: ...
    def __add__(self, o: Cell) -> Cell: ...
    def __sub__(self, o: Cell) -> Cell: ...
    def __mul__(self, k: int) -> Cell: ...
    def __eq__(self, o: object) -> bool: ...
    def __hash__(self) -> int: ...
    def manhattan(self, o: Cell) -> int: ...
    UP: Cell
    """Always (0, -1): directions are in cell space (row - 1 is "up"). A grid's
    `row_order` only decides where rows sit in the world, never what UP means."""
    DOWN: Cell
    LEFT: Cell
    RIGHT: Cell

class Cell3:
    """Immutable integer block position. Hashable; supports + and -. JSON form: [x, y, z]."""
    x: int
    y: int
    z: int
    def __init__(self, x: int, y: int, z: int) -> None: ...
    def __add__(self, o: Cell3) -> Cell3: ...
    def __sub__(self, o: Cell3) -> Cell3: ...
    def __eq__(self, o: object) -> bool: ...
    def __hash__(self) -> int: ...
    def center(self) -> Vec3: ...
    UP: Cell3
    DOWN: Cell3
